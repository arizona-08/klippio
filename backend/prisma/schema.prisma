// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int       @id @default(autoincrement())
  email                       String    @unique
  firstname                   String
  lastname                    String
  password                    String
  forgotPasswordTokenSelector String?
  forgotPasswordToken         String?
  forgotPasswordTokenExpiry   DateTime?
  role                        Role      @default(STANDARD)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @default(now())

  projects                   Project[]
}


enum Role {
  ADMIN
  STANDARD
  PREMIUM
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   
  expiresAt   DateTime
}

model Project {
  id                  String   @id @default(uuid())
  authorId            Int
  title               String
  address             String
  zipcode             String
  city                String
  lastOpenedAt        DateTime @default(now())
  
  author              User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  plans               Plan[]
  folders             Folder[]
}

model Plan {
  id                  String   @id @default(uuid())
  name                String
  documentStorageKey  String   
  temporaryAccessUrl  String?
  lastOpenedAt        DateTime @default(now())
  projectId           String
  folderId            String

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  markers             Marker[]
  folder              Folder  @relation("FolderToPlans", fields: [folderId], references: [id])
}

model Marker {
  id                  String   @id @default(uuid())
  coordX              Float   
  coordY              Float   
  title               String
  
  planId      String

  markerPhotos        MarkerPhoto[]
  plan                Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model MarkerPhoto {
  id          String   @id @default(uuid())
  photoStorageKey     String
  photoLabel          String
  comment             String?
  temporaryAccessUrl  String?
  
  markerId            String
  marker              Marker   @relation(fields: [markerId], references: [id], onDelete: Cascade)
}

model Folder {
  id              String   @id @default(uuid())
  name            String
  isRoot          Boolean  @default(false)
  lastModifiedAt  DateTime @default(now())
  parentId        String?
  projectId       String

  parent      Folder?  @relation("FolderToSubfolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders  Folder[] @relation("FolderToSubfolders")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plans       Plan[]   @relation("FolderToPlans")
}
